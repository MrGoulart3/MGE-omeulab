name: Pages (manual)

on:
  workflow_dispatch:
    inputs:
      publicar:
        description: Publicar no Pages após revisar o build
        type: boolean
        required: true
        default: false

permissions:
  contents: read

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'
      - uses: actions/setup-node@v6
        with:
          node-version: '24'
          package-manager-cache: false
      - run: python build.py
      - run: python -m unittest discover -s tests -v
      - run: node --test --test-isolation=none tests/site_runtime.test.cjs
      - name: Confirmar arquivos gerados atualizados
        run: git diff --exit-code -- index.html 404.html
      - uses: actions/upload-pages-artifact@v4
        with:
          path: _site
  deploy:
    if: inputs.publicar && github.ref == 'refs/heads/main'
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Publicar artefato revisado
        id: deployment
        uses: actions/deploy-pages@v4
